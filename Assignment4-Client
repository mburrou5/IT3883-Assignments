import socket

s = socket.socket(
    socket.AF_INET,
    socket.SOCK_STREAM
)

s.connect(("127.0.0.1", 25566))


message = input("Type a string : ")

byte_array = message.encode('utf-8')
s.sendall(byte_array)

data = s.recv(1024)

print("Received:", data.decode('utf-8'))

print(s.recv(256).decode('utf-8'))
