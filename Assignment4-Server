import socket

s = socket.socket(
    socket.AF_INET,
    socket.SOCK_STREAM
)

s.bind(("127.0.0.1", 25566))
s.listen()






conn, addr = s.accept()
with conn:
    while True:
        data = conn.recv(1024)
        if not data:
            break

        uppercase_data = data.decode('utf-8').upper()
        conn.sendall(uppercase_data.encode('utf-8'))
